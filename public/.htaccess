<IfModule mod_rewrite.c>
  RewriteEngine On

  # Main domain serves this directory at /nieuw/, while the concept subdomain
  # uses the same directory as its document root.
  RewriteCond %{HTTP_HOST} ^concept\.de-heikneuters\.nl(:[0-9]+)?$ [NC]
  RewriteRule ^nieuw/?$ index.html [L]

  RewriteCond %{HTTP_HOST} ^concept\.de-heikneuters\.nl(:[0-9]+)?$ [NC]
  RewriteRule ^nieuw/(.*)$ $1 [L]
</IfModule>

# Keep the concept environment out of search indexes without affecting the live domain.
<IfModule mod_setenvif.c>
  SetEnvIf Host "^concept\.de-heikneuters\.nl(:[0-9]+)?$" IS_CONCEPT=1
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive" env=IS_CONCEPT
</IfModule>

# Cache static assets while keeping HTML easy to refresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
