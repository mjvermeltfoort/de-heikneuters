---
import BaseLayout from '../layouts/BaseLayout.astro';
const channelUrl = 'https://www.youtube.com/channel/UCTRbf6GaQNeR43AiWMnprlg';
const featuredVideoId = 'Gm5clQOzu04';
const uploadsPlaylistId = 'UUTRbf6GaQNeR43AiWMnprlg';
---

<BaseLayout
  title="Door de jaren heen | C.V. De Heikneuters"
  description="Bekijk C.V. De Heikneuters door de jaren heen in foto's en video's."
  current="history"
>
<section class="section">
  <div class="section__inner">
    <div class="eyebrow">Sinds 1960</div>
    <h1 class="page-title">Door de jaren heen</h1>
    <p class="lead history-intro">
      Al sinds 1960 maken De Heikneuters samen carnaval. In al die jaren zijn er
      talloze mooie momenten, optochten, feesten en muzikale herinneringen ontstaan.
      Op deze pagina verzamelen we een stukje van die geschiedenis in beeld.
    </p>

    <div class="featured-video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${featuredVideoId}`}
        title="Heikneuters Door de jaren heen"
        loading="lazy"
        referrerpolicy="no-referrer"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="section__inner">
    <div class="news-head">
      <div>
        <div class="eyebrow">Beeld uit het archief</div>
        <h2>Meer op YouTube</h2>
      </div>
      <a href={channelUrl} target="_blank" rel="noreferrer">Bekijk ons YouTube-kanaal →</a>
    </div>

    <div class="featured-video youtube-playlist">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/videoseries?list=${uploadsPlaylistId}`}
        title="Nieuwste video's van C.V. De Heikneuters"
        loading="lazy"
        referrerpolicy="no-referrer"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
</BaseLayout>
