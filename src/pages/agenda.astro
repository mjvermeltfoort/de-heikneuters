---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  formatDate,
  formatDay,
  formatEventMeta,
  formatMonth,
  getUpcomingEvents,
} from '../lib/calendar';

const events = await getUpcomingEvents();
---

<BaseLayout
  title="Agenda | C.V. De Heikneuters"
  description="Agenda van C.V. De Heikneuters uit Nijnsel."
  current="agenda"
>
<section class="section section--soft">
  <div class="section__inner">
    <div class="eyebrow">Activiteiten</div>
    <h1 class="page-title">Agenda</h1>
    <p class="lead">
      Bekijk de komende activiteiten van C.V. De Heikneuters in Nijnsel en daarbuiten.
    </p>

    {events.length > 0 ? (
      <div class="events">
        {events.map((event) => (
          <article class="event">
            <div class="event__date">
              <strong>{formatDay(event)}</strong>
              <span>{formatMonth(event)}</span>
            </div>
            <div class="event__body">
              <strong>{event.title}</strong>
              <div class="event__meta">
                {formatDate(event)} · {formatEventMeta(event)}
              </div>
            </div>
            <div class="event__arrow" aria-hidden="true">›</div>
          </article>
        ))}
      </div>
    ) : (
      <p class="lead">Er staan op dit moment geen komende activiteiten in de agenda.</p>
    )}

    <div class="actions" style="margin-top:28px;">
      <a class="button button--outline" href="/">← Terug naar home</a>
    </div>
  </div>
</section>
</BaseLayout>
