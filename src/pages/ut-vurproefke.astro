---
import BaseLayout from '../layouts/BaseLayout.astro';

const photos = [
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-01.webp",
    "width": 1024,
    "height": 576,
    "alt": "Blaasmuzikanten met trompet en trombone tijdens Ut Vurproefke"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-02.webp",
    "width": 1024,
    "height": 681,
    "alt": "Een kapel in groene shirts met slagwerk en blazers"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-03.webp",
    "width": 1024,
    "height": 681,
    "alt": "Bezoekers genieten van de muziek tijdens Ut Vurproefke"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-04.webp",
    "width": 1024,
    "height": 681,
    "alt": "Saxofonisten tijdens een optreden op Ut Vurproefke"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-05.webp",
    "width": 1024,
    "height": 681,
    "alt": "Een kapel in paarse shirts speelt tussen het publiek"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-06.webp",
    "width": 1024,
    "height": 682,
    "alt": "Een kapel in oranje shirts treedt op met trompetten en trombones"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-07.webp",
    "width": 1024,
    "height": 683,
    "alt": "Een volle zaal met muzikanten en publiek bij Ut Vurproefke"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-08.webp",
    "width": 1024,
    "height": 683,
    "alt": "Feestelijke drukte in de zaal tijdens Ut Vurproefke"
  },
  {
    "src": "/assets/ut-vurproefke/ut-vurproefke-09.webp",
    "width": 683,
    "height": 1024,
    "alt": "Trombonisten in groene shirts tijdens een optreden"
  }
];
---

<BaseLayout
  title="Ut Vurproefke | C.V. De Heikneuters"
  description="Ut Vurproefke: het muzikale voorproefje voor carnaval van C.V. De Heikneuters in Nijnsel."
  current="vurproefke"
>
<section class="section section--soft">
  <div class="section__inner content-page">
    <h1 class="page-title">Ut Vurproefke</h1>

    <figure class="page-visual page-visual--wide page-visual--logo">
      <img
        src="/assets/ut-vurproefke-logo.webp"
        width="500"
        height="375"
        alt="Logo van blaaskapellenfestival Ut Vurproefke in Nijnsel"
        loading="eager"
        decoding="async"
      />
    </figure>

    <h2 class="content-subtitle">Het muzikale voorproefje voor carnaval</h2>

    <p class="body-copy">
      Op zaterdagavond van het laatste weekend van oktober vindt sinds 2015 traditioneel
      Ut Vurproefke plaats. Een blaaskapellenfestival waar gezelligheid bovenaan staat.
      Iedere kapel speelt twee keer 20 minuten en de optredens zijn in twee verschillende
      zalen. Bekijk hieronder een sfeerimpressie van de afgelopen edities.
    </p>

    <div class="info-grid">
      <article class="info-card">
        <h3>Wat kun je verwachten?</h3>
        <ul class="content-list">
          <li>Twee optredens per kapel (20 minuten per optreden)</li>
          <li>Een warm welkom en een heerlijk “Vurproefke” voor iedere muzikant</li>
          <li>Een ruimte apart voor de instrumenten</li>
          <li>
            En een avondvullend programma vol muziek en gezelligheid van 20:00 uur
            tot in de late uurtjes!
          </li>
        </ul>
      </article>

      <article class="info-card">
        <h3>Info en aanmelden:</h3>
        <p>
          <a href="mailto:dekneuterkapel@gmail.com">dekneuterkapel@gmail.com</a>
        </p>

        <h3>Locatie:</h3>
        <p>
          Zalencentrum de Beckart<br />
          Oude Lieshoutseweg 7<br />
          5492 HT Sint-Oedenrode
        </p>
      </article>
    </div>
    <section class="photo-section" aria-labelledby="photo-heading">
      <h2 class="content-subtitle" id="photo-heading">Sfeerimpressie van afgelopen edities</h2>
      <div class="photo-gallery">
        {photos.map((photo) => (
          <a
            class="photo-gallery__item"
            href={photo.src}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={photo.alt + ' (open volledige foto in een nieuw tabblad)'}
          >
            <img
              src={photo.src}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </section>
  </div>
</section>
</BaseLayout>

<style>
  .photo-section {
    margin-top: 48px;
  }

  .photo-gallery {
    columns: 2;
    column-gap: 20px;
    margin-top: 24px;
  }

  .photo-gallery__item {
    display: inline-block;
    width: 100%;
    margin-bottom: 20px;
    break-inside: avoid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(14, 47, 87, .06);
  }

  .photo-gallery__item:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }

  .photo-gallery__item img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 600px) {
    .photo-gallery {
      columns: 1;
    }

    .photo-section {
      margin-top: 36px;
    }
  }
</style>
