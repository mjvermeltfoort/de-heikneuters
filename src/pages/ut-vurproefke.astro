---
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout
  title="Ut Vurproefke | C.V. De Heikneuters"
  description="Ut Vurproefke: het muzikale voorproefje op carnaval van C.V. De Heikneuters in Nijnsel."
  current="vurproefke"
>
<section class="section section--soft">
  <div class="section__inner content-page">
    <div class="eyebrow">Sinds 2015</div>
    <h1 class="page-title">Ut Vurproefke</h1>
    <p class="lead">Het muzikale voorproefje op carnaval.</p>

    <figure class="page-visual page-visual--wide">
      <img
        src="https://i.ytimg.com/vi/ibgcwNsQPPI/maxresdefault.jpg"
        width="1280"
        height="720"
        alt="De Kneuterkapel uit Nijnsel"
        loading="eager"
        decoding="async"
      />
      <figcaption>
        De Kneuterkapel organiseert Ut Vurproefke: een avond vol blaasmuziek en gezelligheid.
      </figcaption>
    </figure>
    <p class="body-copy">
      Op zaterdagavond van het laatste weekend van oktober vindt traditioneel
      Ut Vurproefke plaats: een blaaskapellenfestival waar gezelligheid bovenaan
      staat. Iedere kapel speelt twee keer twintig minuten, verdeeld over twee zalen.
    </p>

    <div class="info-grid">
      <article class="info-card">
        <span class="feature-card__kicker">Wat kun je verwachten?</span>
        <ul class="content-list">
          <li>Twee optredens per kapel van 20 minuten</li>
          <li>Een warm welkom en een heerlijk “Vurproefke” voor iedere muzikant</li>
          <li>Een aparte ruimte voor instrumenten</li>
          <li>Een avondvullend programma van 20:00 uur tot in de late uurtjes</li>
        </ul>
      </article>

      <article class="info-card">
        <span class="feature-card__kicker">Locatie & informatie</span>
        <h3>Zalencentrum De Beckart</h3>
        <p>
          Oude Lieshoutseweg 7<br />
          5492 HT Sint-Oedenrode
        </p>
        <p>
          Info en aanmelden:<br />
          <a href="mailto:dekneuterkapel@gmail.com">dekneuterkapel@gmail.com</a>
        </p>
      </article>
    </div>

    <div class="actions page-actions">
      <a class="button button--red" href="/agenda/">Bekijk de agenda →</a>
    </div>
  </div>
</section>
</BaseLayout>
