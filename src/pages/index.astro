---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  formatDay,
  formatEventMeta,
  formatMonth,
  getUpcomingEvents,
} from '../lib/calendar';
import {
  facebookExcerpt,
  formatFacebookDate,
  getLatestFacebookPosts,
} from '../lib/facebook';

const events = (await getUpcomingEvents()).slice(0, 3);
const facebookPosts = await getLatestFacebookPosts(3);

const instagramUrl = 'https://www.instagram.com/c.v.de.heikneuters.nijnsel/';
const facebookUrl = 'https://www.facebook.com/share/19JosouTXi/';
---

<BaseLayout
  title="C.V. De Heikneuters | Carnaval in Nijnsel sinds 1960"
  description="C.V. De Heikneuters uit Nijnsel. Sinds 1960 leverancier van carnavalsplezier, met de Kneuterkapel, activiteiten, optochten en feest."
  current="home"
  home
>
<section class="hero">
  <img
    class="hero__image"
    src="/assets/banner-heikneuters.jpg"
    width="1024"
    height="399"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__content">
    <div class="eyebrow">Sinds 1960 · Nijnsel</div>
    <h1>Carnaval maken we <span>samen</span></h1>
    <p>Leverancier van carnavalsplezier</p>
    <div class="actions">
      <a class="button button--red" href="/agenda/">Bekijk de agenda →</a>
      <a class="button button--ghost" href="#jubileum">66 jaar De Heikneuters</a>
    </div>
  </div>
</section>

<section class="section" id="vereniging">
  <div class="section__inner section__grid">
    <div>
      <div class="eyebrow">C.V. De Heikneuters</div>
      <h2>Sinds 1960 een begrip in onze regio</h2>
      <p class="lead">
        CV de Heikneuters is sinds 1960 een begrip in onze regio! Wat begon met een
        paar feestvierders uit Nijnsel is uitgegroeid tot een actieve carnavalsvereniging
        met een rijk verleden en een sprankelende toekomst. Met hart en ziel zetten wij
        ons in om carnaval ieder jaar weer onvergetelijk te maken – voor jong en oud.
      </p>
      <p class="body-copy">
        Tijdens het carnavalsseizoen barst het feest écht los: zittingen, gezellige
        avonden en natuurlijk deelname aan de Carnavalsoptocht. Maar ook buiten het
        seizoen zijn we actief! Denk aan leuke uitjes, bijeenkomsten, activiteiten en
        andere gezellige evenementen voor al onze leden. Samen maken we herinneringen,
        bouwen we tradities en zorgen we voor verbinding in onze gemeenschap – het hele
        jaar door.
      </p>
      <p class="home-signoff">
        CV de Heikneuters: waar carnaval leeft, groeit en verbindt!
      </p>

    </div>

    <div id="activiteiten">
      <div class="panel-title">
        <h3>Eerstvolgende activiteiten</h3>
        <a href="/agenda/">Volledige agenda →</a>
      </div>

      {events.length > 0 ? (
        <div class="events">
          {events.map((event) => (
            <article class="event">
              <div class="event__date">
                <strong>{formatDay(event)}</strong>
                <span>{formatMonth(event)}</span>
              </div>
              <div class="event__body">
                <strong>{event.title}</strong>
                <div class="event__meta">{formatEventMeta(event)}</div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="body-copy">Er staan op dit moment geen komende activiteiten in de agenda.</p>
      )}
    </div>
  </div>
</section>

<section class="section section--blue" id="kneuterkapel">
  <div class="section__inner spotlight">
    <div>
      <div class="eyebrow eyebrow--light">De Kneuterkapel</div>
      <h2>Feest vanaf de eerste noot</h2>
      <p class="lead lead--light">
        Wat ooit begon als een kleine groep muzikanten binnen De Heikneuters is
        uitgegroeid tot een kapel van 26 muzikanten. Van traditionele blaasmuziek
        tot moderne meezingers: plezier en samen muziek maken staan voorop.
      </p>
      <div class="actions">
        <a class="button button--red" href="/de-kneuterkapel/">Meer over de Kneuterkapel →</a>
        <a class="button button--ghost" href="/agenda/">Bekijk agenda</a>
      </div>
    </div>

  </div>
</section>

<section class="section section--soft">
  <div class="section__inner">
    <div class="section-heading">
      <div class="eyebrow">Meer dan carnaval alleen</div>
      <h2>Dit zijn De Heikneuters</h2>
    </div>

    <div class="feature-grid">
      <article class="feature-card" id="vurproefke">
        <span class="feature-card__kicker">Sinds 2015</span>
        <h3>Ut Vurproefke</h3>
        <p>
          Het muzikale voorproefje op carnaval. Blaaskapellen, twee podia,
          een avondvullend programma en vooral heel veel gezelligheid bij
          De Beckart in Nijnsel.
        </p>
        <a href="/ut-vurproefke/">Meer over Ut Vurproefke →</a>
      </article>

      <article class="feature-card" id="steun-ons">
        <span class="feature-card__kicker">Word vriend</span>
        <h3>Vrienden van de Heikneuters</h3>
        <p>
          Draag je onze vereniging een warm hart toe? Vanaf € 11,11 per jaar
          help je mee om carnaval in Nijnsel kleurrijk, gezellig en toegankelijk
          te houden voor jong en oud.
        </p>
        <a href="/vrienden-van-de-heikneuters/">Meer over Vrienden →</a>
      </article>

      <article class="feature-card">
        <span class="feature-card__kicker">Sinds 1960</span>
        <h3>Door de jaren heen</h3>
        <p>
          Zesenzestig jaar De Heikneuters betekent een flinke verzameling
          herinneringen. Bekijk oude en nieuwe beelden van carnaval, optochten,
          feesten en de Kneuterkapel.
        </p>
        <a href="/door-de-jaren-heen/">Duik in het videoarchief →</a>
      </article>
    </div>

    <aside class="jubilee" id="jubileum">
      <div class="eyebrow" style="color:#ff6b73">1960 — 2026</div>
      <h3>66 jaar De Heikneuters</h3>
      <p>
        Een jubileum dat we niet stilletjes voorbij laten gaan. In ons 66e jaar
        kijken we terug op mooie herinneringen én vooruit naar nieuwe feesten,
        activiteiten en carnavalsmomenten. Iedereen is welkom om met ons mee te vieren.
      </p>
      <div class="actions">
        <a class="button button--red" href="/agenda/">Bekijk jubileumactiviteiten →</a>
        <a class="button button--ghost" href={instagramUrl} target="_blank" rel="noreferrer">
          Volg het jubileum
        </a>
      </div>
    </aside>
  </div>
</section>

<section class="section social-section" id="nieuws">
  <div class="section__inner">
    <div class="news-head">
      <div>
        <div class="eyebrow">Laatste nieuws</div>
      </div>
      <a href={facebookUrl} target="_blank" rel="noreferrer">Bekijk onze Facebookpagina →</a>
    </div>

    {facebookPosts.length > 0 ? (
      <div class="facebook-grid">
        {facebookPosts.map((post) => (
          <article class="facebook-card">
            {post.imageUrl && (
              <a
                class="facebook-card__image"
                href={post.permalinkUrl}
                target="_blank"
                rel="noreferrer"
                aria-label="Bekijk Facebookbericht"
              >
                <img
                  src={post.imageUrl}
                  alt=""
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class="facebook-card__body">
              <time datetime={post.createdTime.toISOString()}>
                {formatFacebookDate(post.createdTime)}
              </time>
              <p>{facebookExcerpt(post.message)}</p>
              <a href={post.permalinkUrl} target="_blank" rel="noreferrer">
                Bekijk bericht op Facebook →
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="social-panel">
        <div>
          <h2>Volg ons op onze socials</h2>
          <p class="lead">
            Voor het laatste nieuws, foto's, aankondigingen en alles rondom ons
            66-jarig jubileum vind je De Heikneuters op Instagram en Facebook.
          </p>
        </div>
        <div class="social-actions">
          <a class="social-button" href={instagramUrl} target="_blank" rel="noreferrer">
            <span>◎</span>
            <strong>Instagram</strong>
            <small>@c.v.de.heikneuters.nijnsel</small>
          </a>
          <a class="social-button" href={facebookUrl} target="_blank" rel="noreferrer">
            <span>f</span>
            <strong>Facebook</strong>
            <small>C.V. De Heikneuters Nijnsel</small>
          </a>
        </div>
      </div>
    )}
  </div>
</section>
</BaseLayout>
