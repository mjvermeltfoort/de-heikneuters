---
import BaseLayout from '../layouts/BaseLayout.astro';

const googleFormAction =
  'https://docs.google.com/forms/d/e/1FAIpQLSeu1iuHXbT969Nlc_ps89rSt-Oyu6kRawdWi3rthSfAMGbXJw/formResponse';
---

<BaseLayout
  title="Vrienden van de Heikneuters | C.V. De Heikneuters"
  description="Word vriend van C.V. De Heikneuters en steun carnaval in Nijnsel."
  current="vrienden"
>
<section class="section">
  <div class="section__inner content-page">
    <div class="eyebrow">Steun de vereniging</div>
    <h1 class="page-title">Vrienden van de Heikneuters</h1>

    <figure class="page-visual page-visual--group">
      <img
        src="https://de-heikneuters.nl/wp-content/uploads/2025/06/Groepsfoto-Heikneuters-1024x399.jpeg"
        width="1024"
        height="399"
        alt="Groepsfoto van C.V. De Heikneuters"
        loading="eager"
        decoding="async"
      />
    </figure>

    <p class="body-copy">
      Vier je carnaval? Dan heb je ons vast wel ooit gezien. In het blauw met rood gekleed
      gaan we door de straten van Nijnsel en Papgat. Wij zijn CV de Heikneuters uit Nijnsel.
      Naast het muzikaal opluisteren van de straten van Nijnsel tijdens de kinderoptocht,
      het organiseren van het carnavalsbal op carnavalsmaandag, het tonen van kleurrijke
      creaties tijdens de optocht in Papgat op carnavalszondag hebben we ook nog een tal van
      activiteiten voor onze eigen leden. Denk daarbij aan een spelletjesavond, een familiedag,
      een bezoek van Sinterklaas voor de allerkleinsten en eens per twee jaar een vage
      vriendenweekend. Naast onze volwassen leden hebben we tijdens onze diverse activiteiten
      ook veel jeugdleden die enthousiast betrokken zijn.
    </p>

    <p class="body-copy">
      Draagt u onze vereniging een warm hart toe, maar heeft u geen zin in de rechten en
      plichten dan is “Vrienden van de Heikneuters” een goed alternatief. Voor een bedrag
      van € 11,11 of een veelvoud daarvan per jaar bent u al vriend van de Heikneuters.
      Met uw jaarlijkse gift kunnen wij ons blijven inzetten voor een mooie, gezellige,
      kleurrijke en sfeervolle carnaval voor jong en oud.
    </p>

    <p class="body-copy">
      Op jaarlijkse basis zullen wij de “Vrienden van de Heikneuters” een update van onze
      activiteiten en bezigheden sturen.
    </p>

    <div class="contact-form-card" id="vriend-worden">
      <span class="feature-card__kicker">Enthousiast geworden?</span>
      <h3>Word nu vriend van CV de Heikneuters!</h3>
      <p class="form-intro">
        Vul hieronder je gegevens in. Je aanmelding wordt rechtstreeks verwerkt in
        ons bestaande formulier, zonder dat je onze website hoeft te verlaten.
      </p>

      <div class="form-status form-status--success" data-friend-success hidden>
        <strong>Bedankt voor je aanmelding!</strong><br />
        We nemen contact met je op over je bijdrage als vriend van De Heikneuters.
      </div>

      <div class="form-status form-status--error" data-friend-error hidden>
        Het verzenden is niet gelukt. Probeer het opnieuw of mail naar
        <a href="mailto:info@de-heikneuters.nl">info@de-heikneuters.nl</a>.
      </div>

      <form
        class="contact-form"
        action={googleFormAction}
        method="post"
        data-friend-form
      >
        <div class="form-field">
          <label for="friend-name">Naam *</label>
          <input
            id="friend-name"
            name="entry.88467631"
            type="text"
            autocomplete="name"
            maxlength="120"
            required
          />
        </div>

        <div class="form-field">
          <label for="friend-email">E-mailadres *</label>
          <input
            id="friend-email"
            name="entry.1710876788"
            type="email"
            autocomplete="email"
            maxlength="180"
            required
          />
        </div>

        <div class="form-field">
          <label for="friend-amount">Jaarlijkse bijdrage *</label>
          <select id="friend-amount" name="entry.1631100819" required>
            <option value="">Kies een bedrag</option>
            <option value="€ 11,11">€ 11,11</option>
            <option value="€ 22,22">€ 22,22</option>
            <option value="€ 33,33">€ 33,33</option>
            <option value="€ 44,44">€ 44,44</option>
            <option value="€ 55,55">€ 55,55</option>
            <option value="€ 66,66">€ 66,66</option>
            <option value="€ 77,77">€ 77,77</option>
            <option value="€ 88,88">€ 88,88</option>
          </select>
        </div>

        <div class="form-field">
          <label for="friend-notes">Opmerkingen</label>
          <textarea
            id="friend-notes"
            name="entry.2137376407"
            rows="5"
            maxlength="3000"
          ></textarea>
        </div>

        <input type="hidden" name="fvv" value="1" />
        <input type="hidden" name="pageHistory" value="0" />
        <input type="hidden" name="submissionTimestamp" value="-1" />

        <button class="button button--red" type="submit" data-friend-submit>
          Aanmelden als vriend →
        </button>

        <p class="form-note">
          We gebruiken je gegevens alleen voor je aanmelding als vriend van De Heikneuters.
        </p>
      </form>
    </div>
  </div>
</section>

<script slot="scripts">
  const friendForm = document.querySelector('[data-friend-form]');
  const friendSuccess = document.querySelector('[data-friend-success]');
  const friendError = document.querySelector('[data-friend-error]');
  const friendSubmit = document.querySelector('[data-friend-submit]');

  friendForm?.addEventListener('submit', async (event) => {
    if (!(friendForm instanceof HTMLFormElement)) return;

    event.preventDefault();
    friendSuccess?.setAttribute('hidden', '');
    friendError?.setAttribute('hidden', '');

    if (!friendForm.reportValidity()) return;

    if (friendSubmit instanceof HTMLButtonElement) {
      friendSubmit.disabled = true;
      friendSubmit.textContent = 'Bezig met versturen…';
    }

    try {
      await fetch(friendForm.action, {
        method: 'POST',
        mode: 'no-cors',
        body: new FormData(friendForm),
      });

      friendForm.reset();

      if (friendSuccess instanceof HTMLElement) {
        friendSuccess.hidden = false;
        friendSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (error) {
      console.error('Vriendenformulier verzenden mislukt:', error);

      if (friendError instanceof HTMLElement) {
        friendError.hidden = false;
      }
    } finally {
      if (friendSubmit instanceof HTMLButtonElement) {
        friendSubmit.disabled = false;
        friendSubmit.textContent = 'Aanmelden als vriend →';
      }
    }
  });
</script>
</BaseLayout>
