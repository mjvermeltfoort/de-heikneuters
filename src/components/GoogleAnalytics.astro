    max-height: calc(100dvh - 32px);
    overflow: auto;
    margin-inline: auto;
    padding: 22px;
    color: var(--ink);
    background: #fff;
    border: 2px solid var(--blue);
    border-top: 4px solid var(--red);
    border-radius: 14px;
    box-shadow: 0 8px 40px #072f6333;
  }
  .analytics-consent h2 { margin: 0 0 8px; font-size: 1.2rem; }
  .analytics-consent p { margin: 0; font-size: .95rem; line-height: 1.6; }
  .analytics-consent a { color: var(--blue-dark); text-decoration: underline; }
  .analytics-consent__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  .analytics-consent button {
    flex: 1;
    min-height: 44px;
    padding: 10px 20px;
    border: 1px solid var(--blue-dark);
    border-radius: 8px;
    background: #fff;
    color: var(--blue-dark);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .analytics-consent button:hover { background: var(--soft); }
  @media (prefers-reduced-motion: reduce) {
    html:focus-within { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
  .analytics-consent :focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
</style>
