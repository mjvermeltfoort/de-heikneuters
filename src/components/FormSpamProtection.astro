---
interface Props {
  inputId: string;
}

const { inputId } = Astro.props;
---

<!-- Het PHP-endpoint controleert dit verborgen veld en een tijdelijk sessietoken. -->
<div class="form-spam-trap" aria-hidden="true">
  <label for={inputId}>Website (laat dit veld leeg)</label>
  <input
    id={inputId}
    name="website_url"
    type="text"
    tabindex="-1"
    autocomplete="off"
    data-spam-honeypot
  />
</div>

<style>
  .form-spam-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script is:inline>
  (() => {
    if (window.HeikneutersFormSpam) return;

    // Gedeelde verzendlogica voor beide formulieren; validatie gebeurt op de server.
    window.HeikneutersFormSpam = {
      forForm(form) {
        let tokenPromise;

        const refresh = () => {
          tokenPromise = fetch(form.action + '?token=1', {
            credentials: 'same-origin',
            cache: 'no-store',
          })
            .then(async (response) => {
              if (!response.ok) return null;
              const data = await response.json();
              return data.success === true && typeof data.token === 'string'
                ? data.token
                : null;
            })
            .catch(() => null);
        };

        // Start bij het openen van het formulier: het token heeft een minimale leeftijd.
        refresh();

        return {
          async submit() {
            const token = await tokenPromise;
            if (!token) throw new Error('Formuliertoken kon niet worden opgehaald');

            const formData = new FormData(form);
            formData.set('form_token', token);

            const response = await fetch(form.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: { Accept: 'application/json' },
              body: formData,
            });
            const data = await response.json().catch(() => null);

            if (!response.ok || data?.success !== true) {
              const error = new Error('PHP-formuliercontrole heeft verzending geweigerd');
              error.userMessage = typeof data?.message === 'string' ? data.message : null;
              throw error;
            }
          },

          refresh,
        };
      },
    };
  })();
</script>
