---
import SocialIcon from './SocialIcon.astro';

const facebookUrl = 'https://www.facebook.com/share/19JosouTXi/';
const instagramUrl = 'https://www.instagram.com/c.v.de.heikneuters.nijnsel/';
const youtubeUrl = 'https://www.youtube.com/channel/UCTRbf6GaQNeR43AiWMnprlg';

const quickLinks = [
  { label: 'Vereniging', href: '/#vereniging' },
  { label: 'Kneuterkapel', href: '/de-kneuterkapel/' },
  { label: 'Agenda', href: '/agenda/' },
  { label: '66 jaar', href: '/#jubileum' },
];

const moreLinks = [
  { label: 'Ut Vurproefke', href: '/ut-vurproefke/' },
  { label: 'Vrienden', href: '/vrienden-van-de-heikneuters/' },
  { label: 'Door de jaren heen', href: '/door-de-jaren-heen/' },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div>
        <h4>C.V. De Heikneuters</h4>
        <p>
          Leverancier van carnavalsplezier in Nijnsel sinds 1960.
          Samen maken we carnaval.
        </p>
        <div class="footer-socials" aria-label="Social media">
          <a href={facebookUrl} target="_blank" rel="noreferrer" aria-label="Facebook">
            <SocialIcon name="facebook" size={18} />
          </a>
          <a href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Instagram">
            <SocialIcon name="instagram" size={18} />
          </a>
          <a href={youtubeUrl} target="_blank" rel="noreferrer" aria-label="YouTube">
            <SocialIcon name="youtube" size={19} />
          </a>
        </div>
      </div>

      <div>
        <h4>Snel naar</h4>
        <ul>
          {quickLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Meer</h4>
        <ul>
          {moreLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="/contact/">Contactformulier</a></li>
          <li><a href="mailto:info@de-heikneuters.nl">info@de-heikneuters.nl</a></li>
          <li><a href="tel:+31630237107">06 30237107</a></li>
          <li>Nijnsel · Sint-Oedenrode</li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      © 2026 C.V. De Heikneuters · Nijnsel
    </div>
  </div>
</footer>
