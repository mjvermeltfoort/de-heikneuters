---
import SocialIcon from './SocialIcon.astro';

interface Props {
  current?: string;
  home?: boolean;
}

const { current = '', home = false } = Astro.props;

const logoUrl = '/assets/logo-heikneuters-2026.png';
const instagramUrl = 'https://www.instagram.com/c.v.de.heikneuters.nijnsel/';
const facebookUrl = 'https://www.facebook.com/share/19JosouTXi/';
const youtubeUrl = 'https://www.youtube.com/channel/UCTRbf6GaQNeR43AiWMnprlg';

const menuItems = [
  { key: 'agenda', label: 'Agenda', href: '/agenda/' },
  { key: 'history', label: 'Door de jaren heen...', href: '/door-de-jaren-heen/' },
  { key: 'vrienden', label: 'Vriend van worden', href: '/vrienden-van-de-heikneuters/' },
  { key: 'kneuterkapel', label: 'De Kneuterkapel', href: '/de-kneuterkapel/' },
  { key: 'vurproefke', label: 'Ut Vurproefke', href: '/ut-vurproefke/' },
  { key: 'jubileum', label: 'Heikneuters 66 jaar', href: '/heikneuters-66-jaar/' },
  { key: 'contact', label: 'Contact', href: '/contact/' },
];
---

{home && (
  <div class="topbar">
    <div class="topbar__inner">
      <span>Volg De Heikneuters:</span>
      <div class="socials" aria-label="Social media">
        <a class="social" href={facebookUrl} target="_blank" rel="noreferrer" aria-label="Facebook">
          <SocialIcon name="facebook" size={15} />
        </a>
        <a class="social" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Instagram">
          <SocialIcon name="instagram" size={15} />
        </a>
        <a class="social" href={youtubeUrl} target="_blank" rel="noreferrer" aria-label="YouTube">
          <SocialIcon name="youtube" size={16} />
        </a>
      </div>
    </div>
  </div>
)}

<header class:list={['nav', !home && 'nav--standalone']}>
  <div class="nav__inner">
    <a href="/" aria-label="C.V. De Heikneuters home">
      <img
        class="logo"
        src={logoUrl}
        width="240"
        height="375"
        alt="Logo C.V. De Heikneuters Nijnsel"
      />
    </a>

    <nav class="nav__links" aria-label="Hoofdnavigatie">
      {menuItems.map((item) => (
        <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <button class="menu-button" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-nav">
      ☰
    </button>
  </div>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="Mobiele navigatie">
  {menuItems.map((item) => (
    <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
      {item.label}
    </a>
  ))}
</nav>

<script>
  const menuButton = document.querySelector('.menu-button');
  const mobileNav = document.querySelector('.mobile-nav');

  menuButton?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('is-open') ?? false;
    menuButton.setAttribute('aria-expanded', String(open));
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('is-open');
      menuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
